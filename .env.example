# =============================================================================
#  Lebenszeichen — environment
#  Copy to `.env` and fill in. NEVER commit the filled file.
# =============================================================================

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lebenszeichen?schema=public"

# --- Site identity -----------------------------------------------------------
# SITE_NAME is the temporary brand placeholder. Change it here (and in
# /admin/settings) once the final brand name is decided — nothing else needs
# to be touched.
SITE_NAME="Lebenszeichen"
# Public base URL, no trailing slash. Used for canonical URLs, OG tags, sitemap.
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Lebenszeichen"

# --- Auth --------------------------------------------------------------------
# Signing key for admin session cookies. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=""
# Session lifetime in hours.
AUTH_SESSION_HOURS="12"

# --- Media storage -----------------------------------------------------------
# `local` writes to ./public/uploads. The storage layer is an abstraction, so an
# S3/R2 driver can be added without touching call sites (server/media/storage.ts).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="public/uploads"
STORAGE_PUBLIC_PREFIX="/uploads"
# Max upload size in megabytes.
UPLOAD_MAX_MB="10"

# --- AI provider -------------------------------------------------------------
# mock  = no network calls, deterministic output (safe default for dev/CI)
# fal   = fal.ai (text via any-llm, images via FLUX)
AI_PROVIDER="mock"
FAL_KEY=""
# Text model used for rewriting/generation through fal.ai any-llm.
AI_TEXT_MODEL="google/gemini-2.5-flash"
# Cheaper model for short jobs (headlines, tags, SEO).
AI_TEXT_MODEL_FAST="google/gemini-2.5-flash-lite"
# Image model used for cover generation.
AI_IMAGE_MODEL="fal-ai/flux-2/turbo"

# --- Advertising -------------------------------------------------------------
# Master switch. When false, no ad script is loaded anywhere in production.
ADS_ENABLED="false"
NEXT_PUBLIC_ADS_ENABLED="false"
# adsense | none
NEXT_PUBLIC_ADS_PROVIDER="adsense"
# AdSense publisher id, format ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
# Let AdSense place extra formats itself (anchor + vignette) on top of our slots.
NEXT_PUBLIC_ADSENSE_AUTO_ADS="false"

# Per-slot ad unit ids from the AdSense dashboard (numeric strings).
NEXT_PUBLIC_AD_SLOT_HOME_TOP=""
NEXT_PUBLIC_AD_SLOT_HOME_FEED_1=""
NEXT_PUBLIC_AD_SLOT_HOME_FEED_2=""
NEXT_PUBLIC_AD_SLOT_CATEGORY_TOP=""
NEXT_PUBLIC_AD_SLOT_CATEGORY_FEED=""
NEXT_PUBLIC_AD_SLOT_ARTICLE_AFTER_INTRO=""
NEXT_PUBLIC_AD_SLOT_ARTICLE_INLINE=""
NEXT_PUBLIC_AD_SLOT_ARTICLE_END=""
NEXT_PUBLIC_AD_SLOT_SIDEBAR=""
NEXT_PUBLIC_AD_SLOT_SIDEBAR_STICKY=""
NEXT_PUBLIC_AD_SLOT_MOBILE_STICKY=""
NEXT_PUBLIC_AD_SLOT_SEARCH_TOP=""

# --- Interstitial / popunder network (NOT AdSense) ---------------------------
# Off by default and intentionally so. Popunder-style formats are forbidden by
# Google AdSense; enabling one on a page that also serves AdSense will get the
# AdSense account terminated. Only switch this on for a site monetised by a
# network that explicitly permits the format, and read docs/ADSENSE.md first.
NEXT_PUBLIC_POPUNDER_ENABLED="false"
# Script URL supplied by that network. Loaded verbatim, nothing is hand-rolled.
NEXT_PUBLIC_POPUNDER_SCRIPT_URL=""
# Hours between two triggers for the same visitor.
NEXT_PUBLIC_POPUNDER_FREQUENCY_HOURS="12"

# --- Consent / GDPR ----------------------------------------------------------
# none | funding-choices | custom
# A certified CMP must be plugged in before serving personalised ads in the EU.
NEXT_PUBLIC_CMP_PROVIDER="none"
# Google Funding Choices / Privacy & messaging publisher id (ca-pub-...).
NEXT_PUBLIC_CMP_FUNDING_CHOICES_ID=""

# --- Analytics ---------------------------------------------------------------
# none | ga4
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# --- URL importer ------------------------------------------------------------
# Hard limits for the fetcher (SSRF-hardened, see server/content-import).
IMPORT_TIMEOUT_MS="15000"
IMPORT_MAX_BYTES="3000000"
IMPORT_MAX_REDIRECTS="3"

# --- Revalidation ------------------------------------------------------------
# Optional shared secret for POST /api/revalidate (cron / external triggers).
REVALIDATE_SECRET=""
